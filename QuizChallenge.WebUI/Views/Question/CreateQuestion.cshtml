@using QuizChallenge.WebUI.Models.View_Models
@model Question
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers


@{
    ViewData["Title"] = "CreateQuestion";
}

<div class="container">
	<h2>Survey</h2>
	<form method="post" asp-action="CreateQuestion">
      <div class="form-group">
        <label> Text</label>
        <input asp-for="Text" type="text" class="form-control" placeholder="Type question here...">
        <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>
      </div>
      
      <p class"question"="">Correct Answer</p>
      <div class="form-check">
        <input asp-for="CorrectAnswerId"  class="form-control" placeholder="Type correct Answer here...">
        </div>
        <label class="form-check-label">
            Quiz ID
          </label>
        <div class="form-check">
@*            @Model.QuizId
*@        <input asp-for="QuizId" class="form-control" placeholder="Type correct Answer here...">

        </div>
            <div>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
    </form>
</div>


