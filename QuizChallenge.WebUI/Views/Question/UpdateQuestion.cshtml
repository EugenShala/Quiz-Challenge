@model Question
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers


@{
    ViewData["Title"] = "UpdateQuestion";
}

<div class="container">
	<h2>Question</h2>
	<form method="post" asp-action="UpdateQuestion">
        <input asp-for="Id" hidden />
          <div class="mb-3 row">

      <div class="form-group">
        <label> Text</label>
        <input asp-for="Text" type="text" class="form-control" placeholder="Type question here...">
      </div>
      
      <p class"question"="">Correct Answer</p>
      <div class="form-check">
        <input asp-for="CorrectAnswerId"  class="form-control" placeholder="Type correct Answer here...">
        </div>
        <label class="form-check-label">
            Quiz ID
          </label>
        <div class="form-check">
    <input asp-for="QuizId" class="form-control" placeholder="Type correct Answer here...">
        </div>
        <div asp-validation-summary="ModelOnly"></div>
            </div>
            <div>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
    </form>
</div>




