@model Answer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers


@{
    ViewData["Title"] = "UpdateAnswer";
}



<div class="container">
	<h2>Answer</h2>
<form method="post" asp-action="UpdateAnswer">
      <input asp-for="Id" hidden />
      <div class="form-group">
        <label> Text</label>
        <input asp-for="Text" type="text" class="form-control" placeholder="Type question here...">
              @Html.ValidationMessageFor(x => x.Text)
      </div>
      
      <p class"question"="">Question ID</p>
      <div class="form-check">
        <input asp-for="QuestionId" type="number"  class="form-control" placeholder="Choose Question ID here...">
              @Html.ValidationMessageFor(x => x.QuestionId)
        </div>
            <div>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
    </form>
</div>
